# Copy to .env (gitignored) and fill in the password. `go run` of cmd/api and cmd/migrate loads it
# from any directory inside the module; a variable already set in the environment wins.

# The database you play against locally. `go run ./cmd/migrate` brings it up to date and
# seeds the quizzes; the API refuses to start until that has run.
DATABASE_URL=postgres://postgres:<password>@localhost:5432/playhausdb?sslmode=disable

# A separate, throwaway database for `go test ./...`. Every test creates and drops a schema
# of its own in it, so never point this at playhausdb.
TEST_DATABASE_URL=postgres://postgres:<password>@localhost:5432/playhausdb_test?sslmode=disable

# Optional, and off by default. Setting it registers GET /api/v1/admin/stats -- goroutines,
# heap, GC and the realtime hub's live rooms -- guarded by this value in an X-Stats-Token
# header. Unset, the route is not registered at all.
#STATS_TOKEN=any-long-random-string
