# Dependencies and build output are produced inside the image, never carried into it: a
# host node_modules is built for the host's platform, and a stale dist/ would be copied
# over the one the build just made.
node_modules/
.expo/
dist/
web-build/

# The committed .env points at a laptop's localhost:8080 and turns dev-mode shortcuts on.
# The image gets its values from build args instead, so keeping the file out of the context
# means there is only one place a deployed bundle's configuration can come from.
.env
.env*.local

# Generated native folders, editor and OS junk.
/ios
/android
.kotlin/
.vscode/
.claude/
.DS_Store
.metro-health-check*
npm-debug.*
