{
  "expo": {
    "name": "playhaus-app",
    "slug": "playhaus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "playhausapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.svg",
        "dark": "./assets/images/icon-dark.svg",
        "tinted": "./assets/images/icon-tinted.svg"
      },
      "bundleIdentifier": "com.nielsengelhard.playhausapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nielsengelhard.playhausapp",
      "adaptiveIcon": {
        "backgroundColor": "#FEFCF4",
        "foregroundImage": "./assets/images/android-icon-foreground.svg",
        "monochromeImage": "./assets/images/android-icon-monochrome.svg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.svg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F0",
          "image": "./assets/images/playhaus-lockup-light.svg",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/playhaus-lockup-light.svg",
            "backgroundColor": "#1B1A22"
          }
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan a host's QR code so you can join their lobby.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f53f2c33-33cf-4417-9c87-2ea2dbf1a951"
      }
    }
  }
}
