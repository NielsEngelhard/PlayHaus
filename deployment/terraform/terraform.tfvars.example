# Copy to terraform.tfvars and fill in. That file is gitignored -- it holds a token that
# can create and destroy everything in your DigitalOcean account.

# https://cloud.digitalocean.com/account/api/tokens -- needs read and write scope.
do_token = "dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

domain     = "playhaus.site"
acme_email = "engelhardniels@gmail.com"

# Defaults are ams3 and the $6/month s-1vcpu-1gb. Uncomment to change.
# region       = "ams3"
# droplet_size = "s-1vcpu-1gb"

# Verbatim contents of the .pub files, one line each. Spell the path out in PowerShell --
# it does not expand ~, and Windows ssh-keygen does not either.
#
#   Get-Content "$env:USERPROFILE\.ssh\id_ed25519.pub"
admin_ssh_public_key = "ssh-ed25519 AAAA... you@yourmachine"

#   ssh-keygen -t ed25519 -C "playhaus-ci" -f "$env:USERPROFILE\.ssh\playhaus_ci"   (no passphrase)
#   Get-Content "$env:USERPROFILE\.ssh\playhaus_ci.pub"
ci_ssh_public_key = "ssh-ed25519 AAAA... playhaus-ci"

# DigitalOcean weekly droplet backups, ~$1.20/month. The SQLite database has no other
# copy; this is the one line that changes that.
# enable_backups = true
