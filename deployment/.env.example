# Values for the LOCAL compose file in this directory (deployment/docker-compose.yml),
# which builds both images from source. Copy to .env and adjust, or just export them.
#
# The droplet does not use this file: deployment/server/docker-compose.yml reads a
# different .env, written on the server by deployment/server/deploy.sh.

# The origin the browser will use, baked into the web bundle at build time. It has to be
# the bare origin -- src/api/client.ts appends /api/v1/... itself, and src/api/socket.ts
# derives the websocket URL from it by swapping http for ws.
PUBLIC_ORIGIN=http://localhost:3000

# Host port the app container's :80 is published on. Keep it in step with PUBLIC_ORIGIN:
# a mismatch produces a page that loads and an API that is not there.
PUBLIC_PORT=3000
